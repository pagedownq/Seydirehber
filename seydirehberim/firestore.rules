rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'mehmetirem305@gmail.com' || 
         request.auth.token.email == 'bilgimgverse@gmail.com' ||
         request.auth.token.email == 'seydirehber@gmail.com' ||
         exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }

    match /admins/{email} {
      allow read: if request.auth != null && (request.auth.token.email == email || isAdmin());
      allow write: if isAdmin();
    }

    // Esnaf yetki kontrolü kaldırıldı (Auth kullanılmadığı için kurallar esnetildi)
    function isEsnaf(firmaId) {
      return true; // Esnaf_web Auth kullanmadığından bypass edildi
    }

    match /yardim_destek/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /sikayetler/{docId} {
      allow create: if true; // Everyone can report content
      allow read: if isAdmin() || (request.auth != null && resource.data.reporterId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /user_tokens/{docId} {
      allow read: if isAdmin();
      allow write: if true; // Everyone can register their device token
    }

    match /duyurular/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public collections (Read: public, Write: admin)
    match /banners/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /etkinlikler/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /noterler/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /pazarlar/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /otobus_saatleri/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /gezilecek_yerler/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /firmalar/{docId} { 
      allow read: if true; 
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['goruntulenme']);
      allow write: if isAdmin(); 
    }

    // Yorumlar kuralları
    match /reviews/{docId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Alt koleksiyon yorumları (Nested Reviews)
    match /targets/{targetType}/items/{targetId}/reviews/{docId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // --- KUPON & ESNAF SİSTEMİ KURALLARI ---
    
    match /esnaf_users/{docId} {
      // Esnaf panelinde giriş yapabilmek için (Auth olmadan) okumaya açık olmalı
      allow read: if true;
      allow write: if isAdmin(); 
    }

    match /coupons/{docId} {
      // Kuponları uygulamadaki herkes okuyabilir, sadece admin oluşturup silebilir.
      allow read: if true;
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used_count']));
      allow write: if isAdmin();
    }

    match /generated_codes/{docId} {
      // 1. Kullanıcı kendi kodunu oluşturabilir.
      // (Bunu kendi UID'si ile oluşturmak zorunda)
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Müşteri kendi kodunu okuyabilir, admin ve esnaf da arama yapabilir
      allow read: if true;
                  
      // 3. Güncelleme Yetkisi (Transaction anı):
      // - Herkes ('kodu bilen') sadece durumu 'pending' den 'used'a alabilir ve usedAt atayabilir. (Auth kaldırıldığı için sınırlı yetki açıldı)
      allow update: if isAdmin() || 
                    (
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedAt']) &&
                      request.resource.data.status == 'used' && 
                      resource.data.status == 'pending'
                    );
                    
      allow delete: if isAdmin();
    }
    // ----------------------------------------
    
    // Default fallback rule: denies all access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}